# Example local environment settings for MCP servers
# Copy this file to .env and fill in your actual values.

# AWS
AWS_SSO_START_URL="https://<your-sso-url>"
AWS_SSO_REGION="us-east-2"
AWS_PROFILE_NAME="<profile-name>"

# Snowflake
SNOWFLAKE_ACCOUNT="<account-name>"
SNOWFLAKE_USER="<your-email>"
SNOWFLAKE_DATABASE="<database>"
SNOWFLAKE_SCHEMA="<schema>"
SNOWFLAKE_WAREHOUSE="<warehouse>"

# Denodo
DENODO_HOST="<host>"
DENODO_PORT="9443"
DENODO_USER="<user>"

# ServiceNow
SERVICENOW_MCP_URL="https://<instance>.service-now.com/snappcs/mcp-server/mcp/x_koi_ent_it_mcp_item_fulliller"

# Power BI
POWERBI_TENANT_ID="<tenant-id>"
POWERBI_CLIENT_ID="<client-id>"

# Atlassian
ATLASSIAN_CLOUD_ID="<cloud-id>"
ATLASSIAN_CLIENT_ID="<client-id>"

# dbt
DBT_ACCOUNT_ID="<account-id>"
DBT_BASE_URL="https://<org>.us1.dbt.com"
